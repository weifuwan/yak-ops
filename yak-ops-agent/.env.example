# ---- 内网 LLM（openai-compatible 端点与凭证）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# ---- yak-ops 后端 ----
YAK_OPS_BASE_URL=http://127.0.0.1:12345/yak-ops
# 认证：二选一。
# 当前默认——用户名密码登录（POST /login 换 sessionId cookie）：
YAK_OPS_USERNAME=
YAK_OPS_PASSWORD=
# 平台 API token 功能上线后优先使用（设置了 token 则忽略用户名密码）：
YAK_OPS_TOKEN=
# 数据同步闭环默认项目编码（雪花 ID）；留空则每次提问需在问题中给出
YAK_OPS_PROJECT_CODE=
# ---- 可选：HTTP 服务 / 工作区 / 审计（有默认值）----
# YAK_AGENT_HOST=127.0.0.1
# YAK_AGENT_PORT=8090
# YAK_AGENT_SESSION_DIR=sessions
# YAK_AGENT_AUDIT_DIR=logs/audit
