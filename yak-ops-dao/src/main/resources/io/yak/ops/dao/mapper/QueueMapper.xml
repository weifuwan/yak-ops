<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="io.yak.ops.dao.mapper.QueueMapper">
    <sql id="baseSql">
        id, queue_name, queue, create_time, update_time
    </sql>
    <select id="queryQueuePaging" resultType="io.yak.ops.dao.entity.Queue">
        select
        <include refid="baseSql"/>
        from t_yak_ops_queue
        where 1= 1
        <if test="searchVal != null and searchVal != ''">
            and queue_name like concat('%', #{searchVal}, '%')
        </if>
        <if test="ids != null and ids.size() > 0">
            and id in
            <foreach collection="ids" item="i" open="(" close=")" separator=",">
                #{i}
            </foreach>
        </if>
        order by update_time desc
    </select>
    <select id="queryAllQueueList" resultType="io.yak.ops.dao.entity.Queue">
        select
        <include refid="baseSql"/>
        from t_yak_ops_queue
        where 1=1
        <if test="queue != null and queue != ''">
            and queue = #{queue}
        </if>
        <if test="queueName != null and queueName != ''">
            and queue_name =#{queueName}
        </if>
    </select>
    <select id="existQueue" resultType="java.lang.Boolean">
        select 1 = 1
        from t_yak_ops_queue
        where 1 = 1
        <if test="queue != null and queue != ''">
            and queue = #{queue}
        </if>
        <if test="queueName != null and queueName != ''">
            and queue_name =#{queueName}
        </if>
    </select>
    <select id="queryQueueName" resultType="io.yak.ops.dao.entity.Queue">
        select
        <include refid="baseSql"/>
        from t_yak_ops_queue
        <where>
            <if test="queue != null and queue != ''">
                and queue =#{queue}
            </if>
            <if test="queueName != null and queueName != ''">
                and queue_name =#{queueName}
            </if>
        </where>
    </select>
</mapper>
