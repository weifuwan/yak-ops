{
  "name": "YakOps",
  "version": "0.1.0",
  "private": true,
  "description": "A modern third-party Web UI for Apache SeaTunnel",
  "repository": "https://github.com/weifuwan/yak-ops",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "biome:lint": "npx @biomejs/biome lint",
    "build": "max build",
    "deploy": "npm run build && npm run gh-pages",
    "dev": "npm run start:dev",
    "gh-pages": "gh-pages -d dist",
    "i18n-remove": "pro i18n-remove --locale=zh-CN --write",
    "postinstall": "max setup",
    "lint": "npm run biome:lint && npm run tsc",
    "lint-staged": "lint-staged",
    "openapi": "max openapi",
    "prepare": "husky",
    "preview": "npm run build && max preview --port 8000",
    "record": "cross-env NODE_ENV=development REACT_APP_ENV=test max record --scene=login",
    "serve": "umi-serve",
    "start": "cross-env CHECK_TIMEOUT=60 MOCK=none UMI_ENV=dev max dev",
    "start:dev": "cross-env CHECK_TIMEOUT=60 REACT_APP_ENV=dev MOCK=none UMI_ENV=dev max dev",
    "start:no-mock": "cross-env CHECK_TIMEOUT=60 MOCK=none UMI_ENV=dev max dev",
    "start:mock": "cross-env CHECK_TIMEOUT=60 UMI_ENV=dev max dev",
    "start:pre": "cross-env REACT_APP_ENV=pre UMI_ENV=dev max dev",
    "start:test": "cross-env REACT_APP_ENV=test MOCK=none UMI_ENV=dev max dev",
    "tsc": "tsc --noEmit"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/pro-components": "^2.7.19",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@ant-design/x": "^2.2.2",
    "@emoji-mart/data": "^1.1.2",
    "@rc-component/menu": "^1.2.0",
    "@stomp/stompjs": "^7.1.0",
    "antd": "^5.25.4",
    "antd-style": "^3.7.0",
    "autoprefixer": "^10.4.27",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "dnd-kit": "^0.0.2",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.6",
    "emoji-mart": "^5.5.2",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "legendary-cursor": "^1.0.2",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.52.0",
    "ogl": "^1.0.11",
    "postcss": "^8.5.8",
    "react": "^18.3.0",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.0",
    "react-easy-crop": "^4.0.1",
    "react-grid-layout": "^2.2.3",
    "react-json-pretty": "^2.2.0",
    "react-json-view": "^1.21.3",
    "react-resizable": "^4.0.1",
    "reactflow": "11.11.4",
    "sockjs-client": "^1.6.1",
    "three": "^0.183.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@ant-design/pro-cli": "^3.3.0",
    "@biomejs/biome": "^2.0.6",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/express": "^5.0.3",
    "@types/lodash": "^4.17.10",
    "@types/node": "^24.0.10",
    "@types/react": "^18.2.12",
    "@types/react-dom": "^18.2.7",
    "@types/react-helmet": "^6.1.11",
    "@types/sockjs-client": "^1.5.4",
    "@types/three": "^0.183.1",
    "@umijs/max": "^4.3.24",
    "cross-env": "^7.0.3",
    "express": "^4.21.1",
    "gh-pages": "^6.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "mockjs": "^1.1.0",
    "tailwindcss": "^3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "umi-presets-pro": "^2.0.3",
    "umi-serve": "^1.9.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
