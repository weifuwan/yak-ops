<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.yak.ops</groupId>
        <artifactId>yak-ops-alert</artifactId>
        <version>1.4.0</version>
    </parent>
    <artifactId>yak-ops-alert-server</artifactId>
    <packaging>jar</packaging>
    <name>${project.artifactId}</name>
    <dependencies>
        <!-- yak-ops -->
        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-meter</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-spi</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-alert-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-alert-all</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-dao</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-registry-all</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-extract-alert</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-common</artifactId>
        </dependency>
        <!-- yak-ops -->

        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
        <dependency>
            <groupId>org.codehaus.janino</groupId>
            <artifactId>janino</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-actuator-authentication</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>*.yaml</exclude>
                        <exclude>*.xml</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>docker</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
