<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.yak.ops</groupId>
        <artifactId>yak-ops</artifactId>
        <version>1.4.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>yak-ops-standalone-server</artifactId>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.yak.ops</groupId>
                <artifactId>yak-ops-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Bootstrap schema initialization before starting the standalone services. -->
        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-tools</artifactId>
        </dependency>
        <!-- Include MySQL dialect and JDBC driver in standalone IDE and packaged runtimes. -->
        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-dao-mysql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-master</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-worker</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-alert-server</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-alert-all</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-task-all</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-datasource-all</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-storage-all</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>*.yaml</exclude>
                        <exclude>*.xml</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>yak-ops-standalone-server</id>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <finalName>standalone-server</finalName>
                            <descriptors>
                                <descriptor>src/main/assembly/yak-ops-standalone-server.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>false</appendAssemblyId>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
