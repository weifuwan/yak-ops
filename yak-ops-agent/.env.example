# ---- 内网 LLM（openai-compatible 端点与凭证）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# ---- yak-ops 后端 ----
YAK_OPS_BASE_URL=http://127.0.0.1:12345/yak-ops
# 用户身份与工作空间由前端逐请求传入，服务端不再持有平台账号或项目配置：
#   X-Yak-Session-Id    登录换得的 sessionId
#   X-Yak-User-Id       平台用户 id（服务端会向平台反查校验）
#   X-Yak-Workspace-Id  当前工作空间（即 projectCode）
# 可选：平台 API token（CLI / 服务级场景使用）
YAK_OPS_TOKEN=
# ---- 可选：HTTP 服务 / 工作区 / 审计（有默认值）----
# YAK_AGENT_HOST=127.0.0.1
# YAK_AGENT_PORT=8090
# YAK_AGENT_SESSION_DIR=sessions
# YAK_AGENT_AUDIT_DIR=logs/audit
