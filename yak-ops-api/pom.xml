<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.yak.ops</groupId>
        <artifactId>yak-ops</artifactId>
        <version>1.4.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>yak-ops-api</artifactId>
    <packaging>jar</packaging>
    <name>${project.artifactId}</name>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.yak.ops</groupId>
                <artifactId>yak-ops-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- yak-ops -->
        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-service</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.javassist</groupId>
                    <artifactId>javassist</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-dao</artifactId>
        </dependency>
        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-modeling</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-meter</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-spi</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-datasource-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-datasource-all</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-task-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-task-all</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-registry-all</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-scheduler-all</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-storage-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-storage-all</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-extract-master</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-extract-worker</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-extract-alert</artifactId>
        </dependency>
        <!-- yak-ops -->

        <dependency>
            <groupId>org.codehaus.janino</groupId>
            <artifactId>janino</artifactId>
        </dependency>

        <!--springboot-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-to-slf4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- use jetty -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jetty</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.eclipse.jetty.websocket</groupId>
                    <artifactId>javax-websocket-server-impl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.eclipse.jetty.websocket</groupId>
                    <artifactId>websocket-server</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>

        <!-- just for test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Python API's Gateway server -->
        <dependency>
            <groupId>net.sf.py4j</groupId>
            <artifactId>py4j</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ldap</groupId>
            <artifactId>spring-ldap-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.casbin</groupId>
            <artifactId>casdoor-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>io.yak.ops</groupId>
            <artifactId>yak-ops-actuator-authentication</artifactId>
        </dependency>

        <!-- OIDC authentication requires Nimbus directly; do not rely on a cloud SDK's transitive dependency. -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>oauth2-oidc-sdk</artifactId>
        </dependency>
    </dependencies>
    <build>
        <testResources>
            <testResource>
                <directory>${project.basedir}/../yak-ops-dao/src/main/resources</directory>
                <includes>
                    <include>sql/**</include>
                </includes>
            </testResource>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>*.yaml</exclude>
                        <exclude>*.xml</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
