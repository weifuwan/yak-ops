{
  "name": "yak-ops-ui-workspace",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "build": "vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint apps packages --deny-warnings",
    "lint:fix": "oxlint apps packages --fix",
    "format": "oxfmt apps packages",
    "format:check": "oxfmt --check apps packages",
    "check": "npm run format:check",
    "test:auth": "node --experimental-strip-types --test tests/auth-contract.test.mjs",
    "test:management-token": "node --experimental-strip-types --test tests/management-access-tokens.test.mjs",
    "test:data-agent": "node --experimental-strip-types --test tests/data-agent-entrypoints.test.mjs tests/data-agent-api.test.mjs tests/data-agent-markdown.test.mjs tests/data-agent-reducer.test.mjs tests/data-agent-particle-preview.test.mjs",
    "test:http": "node --experimental-strip-types --test tests/http-request-cancellation.test.mjs",
    "test:atom-indicator": "node --experimental-strip-types --test tests/atom-indicator-form-contract.test.mjs",
    "test:data-sync": "node --experimental-strip-types --test tests/data-sync-native-pipeline.test.mjs tests/data-sync-workflow-state.test.mjs tests/data-sync-list-filters.test.mjs tests/data-sync-overview-metrics.test.mjs tests/data-sync-list-execution-state.test.mjs",
    "test:datasource": "node --experimental-strip-types --test tests/datasource-contract.test.mjs tests/datasource-svg-icons.test.mjs tests/datasource-driver-properties.test.mjs",
    "test:resources": "node --experimental-strip-types --test tests/resources-current-dir.test.mjs",
    "test:standards": "node --experimental-strip-types --test tests/modeling-standards-api-contract.test.mjs tests/modeling-standards-tree-visual-contract.test.mjs",
    "test:planning-tree": "node --experimental-strip-types --test tests/modeling-planning-tree-visual-contract.test.mjs",
    "test:derivative-indicator": "node --experimental-strip-types --test tests/derivative-indicator-form-contract.test.mjs",
    "test:composite-indicator": "node --experimental-strip-types --test tests/composite-indicator-form-contract.test.mjs",
    "test:modifier-indicator": "node --experimental-strip-types --test tests/modifier-dw-type-contract.test.mjs",
    "test:indicator-business-type-tree": "node --experimental-strip-types --test tests/indicator-business-type-tree-select.test.mjs",
    "test:dimension-modeling-tree": "node --experimental-strip-types --test tests/dimension-modeling-tree-contract.test.mjs",
    "test:modeling-overview": "node --experimental-strip-types --test tests/data-modeling-overview-visual-contract.test.mjs",
    "test:workflow-logic": "node --experimental-strip-types --test tests/workflow-logic-contract.test.mjs tests/workflow-node-toolbar-contract.test.mjs tests/workflow-task-favorites-contract.test.mjs",
    "test:shell-editor": "node --experimental-strip-types --test tests/shell-task-editor-contract.test.mjs tests/node-resource-params.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
