# ---- 内网 LLM（openai-compatible 端点与凭证）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 目标模型的上下文窗口（tokens）；上下文压缩在 70% 处触发，保留最近 20% 上下文
LLM_CONTEXT_SIZE=128000
# ---- yak-ops 后端 ----
YAK_OPS_BASE_URL=http://127.0.0.1:12345/yak-ops
# 用户身份与工作空间由前端逐请求传入，服务端不再持有平台账号或项目配置：
#   X-Yak-Session-Id    登录换得的 sessionId
#   X-Yak-User-Id       平台用户 id（服务端会向平台反查校验）
#   X-Yak-Workspace-Id  当前工作空间（即 projectCode）
# 可选：平台 API token（仅 CLI / 服务级脚本使用；Web 服务使用前端 sessionId）
YAK_OPS_TOKEN=
# ---- 可选：HTTP 服务 / 工作区 / 审计（有默认值）----
# YAK_AGENT_HOST=127.0.0.1
# YAK_AGENT_PORT=8090
# YAK_AGENT_SESSION_DIR=sessions
# YAK_AGENT_AUDIT_DIR=logs/audit
# 系统提示词目录（AGENT.md + domains/*.md + sections/*.md）；部署可覆盖自定义身份与领域规则
# 相对路径按服务启动目录解析；默认 yak_agent/prompts
# YAK_AGENT_PROMPT_DIR=yak_agent/prompts
# 等待前端确认的超时时间（秒）；超时后本轮按全部拒绝处理
# YAK_AGENT_CONFIRM_TIMEOUT_SECONDS=600
# 消息历史：默认条数上限与单条工具结果截断字符数
# YAK_AGENT_HISTORY_MAX_MESSAGES=200
# YAK_AGENT_HISTORY_TOOL_CHARS=2000
# 长期记忆（ReMe）：按「用户 + 工作空间」隔离，默认开启
YAK_AGENT_MEMORY_ENABLED=true
# 记忆根目录（默认 yak-ops-agent/memory，不放在 sessions/ 下）
# YAK_AGENT_MEMORY_DIR=memory
# 每次检索条数与注入/工具输出预算（tokens）
# YAK_AGENT_MEMORY_TOP_K=5
# YAK_AGENT_MEMORY_BUDGET_TOKENS=1500
# 常驻 profile（称呼/硬偏好）注入预算（tokens，0=关闭读写）
# YAK_AGENT_PROFILE_BUDGET_TOKENS=300
# 回合开始检索超时（秒）与后台写回超时（秒）
# YAK_AGENT_MEMORY_SEARCH_TIMEOUT_SECONDS=3
# YAK_AGENT_MEMORY_WRITE_TIMEOUT_SECONDS=180
# 同时驻留的记忆实例上限、空闲回收（秒）、写回队列长度
# YAK_AGENT_MEMORY_MAX_SCOPES=20
# YAK_AGENT_MEMORY_IDLE_SECONDS=1800
# YAK_AGENT_MEMORY_WRITE_QUEUE=32
# 工具治理：审计开关、工具数量/schema 告警与可选硬上限（0=不阻断）
YAK_AGENT_TOOL_AUDIT_ENABLED=true
# YAK_AGENT_TOOL_COUNT_WARN=20
# YAK_AGENT_TOOL_COUNT_MAX=0
# YAK_AGENT_TOOL_SCHEMA_WARN_TOKENS=6000
# ---- 忙时消息队列（POST /messages?queue=true 时生效）----
# 每会话排队上限；0=关闭排队（忙时仍返回 409）。队列仅在内存中，进程重启后未开始的消息丢失
# YAK_AGENT_SESSION_QUEUE_MAX=5
# 空闲会话卸载：超过该秒数没有活动的会话会从内存卸载（状态已在磁盘上）；0=不卸载
# YAK_AGENT_SESSION_IDLE_SECONDS=1800
# 卸载巡检周期（秒）
# YAK_AGENT_SESSION_EVICT_INTERVAL_SECONDS=60
# ---- PTC 程序化工具调用（默认关闭；开启后每次运行仍需人工确认）----
# 注意：cocoon 沙箱并非完整网络/文件系统隔离，仅在受控环境与可信模型下开启
# YAK_AGENT_PTC_ENABLED=false
# 无真沙箱时允许计算型脚本走无隔离子进程（默认关闭；开启后 SDK 仍不可用）
# YAK_AGENT_PTC_ALLOW_UNSAFE=false
# ---- 会话保留清理（默认关闭，显式启用后才会删除）----
# 按天清理：删除最后活动早于 N 天的会话；0=不按天清理
# YAK_AGENT_SESSION_RETENTION_DAYS=0
# 按容量清理：sessions/ 总大小超过 N MB 时最旧优先删除；0=不按容量清理
# YAK_AGENT_SESSION_MAX_MB=0
# 清理周期（秒）；<=0 表示启动时只跑一次；两阈值均为 0 时不启动清理任务
# YAK_AGENT_SESSION_CLEANUP_INTERVAL_SECONDS=3600
# 单次最多删除的候选数
# YAK_AGENT_SESSION_CLEANUP_BATCH=50
# 试运行：只记录日志不删除，首次启用建议先开
# YAK_AGENT_SESSION_CLEANUP_DRY_RUN=false
