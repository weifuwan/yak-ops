{
  "name": "yak-ops-ui-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "build": "vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "architecture:check": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint apps packages scripts --deny-warnings",
    "lint:fix": "oxlint apps packages scripts --fix",
    "format": "oxfmt apps packages scripts",
    "format:check": "oxfmt --check apps packages scripts",
    "check": "npm run architecture:check && npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
